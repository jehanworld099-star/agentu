# =====================================================================
#  Copy this file, name the copy ".env" (just .env), and fill it in.
#  NEVER share your .env file or put it on GitHub.
# =====================================================================

# ---- 1. Groq (speech-to-text + the AI brain) — FREE tier -------------
# Get it at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- 2. Cartesia (Emma's voice) — free tier --------------------------
# Get it at https://play.cartesia.ai  ->  API Keys
CARTESIA_API_KEY=
# Optional: a different voice. Copy a voice ID from the Cartesia "Voices" page.
CARTESIA_VOICE_ID=156fb8d2-335b-4950-9cb3-a2d33befec77

# ---- 3. Google Sheets (where bookings are saved) — FREE --------------
# The long ID in your sheet's web address: docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=
# On your computer: put the downloaded key file in this folder, named google-credentials.json
GOOGLE_SERVICE_ACCOUNT_FILE=google-credentials.json
# On Railway: instead paste the WHOLE contents of that file here (one line is fine)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- 4. Email alerts to the owner — FREE (Gmail) ---------------------
OWNER_EMAIL=
GMAIL_ADDRESS=
# 16-letter app password from https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ---- 5. Twilio (real phone number) — OPTIONAL, paid ------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your public web address once deployed, e.g. https://cramble-voice-agent-production.up.railway.app
PUBLIC_URL=

# ---- Server (normally leave as is) -----------------------------------
PORT=7860
